{
  "name": "fruit-market",
  "version": "1.1.1",
  "description": "Fruit Market: buy fresh, sell fast, undercut your rivals.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p server && vite build",
    "build:single": "vite build --mode single",
    "test": "vitest run",
    "simulate": "vite-node scripts/simulate.ts",
    "balance": "vite-node scripts/balance.ts",
    "android:sync": "npm run build && npx cap sync android",
    "dev:online": "vite build && wrangler dev --port 8787",
    "deploy:web": "vite build && wrangler deploy",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p server --noEmit",
    "verify": "npm run records:check && npm run palette:check && npm run lint && npm run typecheck && npm test && npm run build",
    "verify:full": "npm run verify && npm run test:e2e",
    "records": "node scripts/records.mjs",
    "records:check": "node scripts/records.mjs --check",
    "test:e2e": "node scripts/e2e.mjs",
    "test:reconnect": "vite build && node scripts/with-server.mjs 'node scripts/e2e-reconnect.cjs $BASE_URL ${E2E_OUT:-e2e-output}'",
    "perf": "vite build --mode single && node scripts/perf-budget.cjs dist-single/index.html",
    "palette": "node scripts/palette.mjs",
    "palette:check": "node scripts/palette.mjs --check"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@cloudflare/workers-types": "^5.20261006.1",
    "@preact/preset-vite": "^2.9.3",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "playwright": "1.63.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.18.0",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.148.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@fontsource/fredoka": "^5.1.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "preact": "^10.25.4"
  },
  "private": true,
  "type": "module"
}
