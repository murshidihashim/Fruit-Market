{
  // Cloudflare Worker: the web game (dist/) plus the online room server.
  "name": "fruit-market",
  "main": "server/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDO" },
      { "name": "STATS", "class_name": "StatsDO" },
      { "name": "BOARD", "class_name": "BoardDO" },
      { "name": "MATCH", "class_name": "MatchDO" },
      { "name": "ACCOUNT", "class_name": "AccountDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO"] },
    { "tag": "v2", "new_sqlite_classes": ["StatsDO", "BoardDO", "MatchDO"] },
    { "tag": "v3", "new_sqlite_classes": ["AccountDO"] }
  ],
  // Per-IP limits for write endpoints (requests per 60 s). See server/limits.ts.
  "ratelimits": [
    { "name": "RL_ROOMS", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_DAILY", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_EVENTS", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_ACCOUNT", "namespace_id": "1004", "simple": { "limit": 12, "period": 60 } }
  ],
  "observability": { "enabled": true },
  // Preview copy for trying changes before they go live (PLAN-001). Its own Worker, so its rooms,
  // leaderboard and stats are separate from the live game. Deployed by CI after checks pass on main.
  // Cloudflare's per-version preview URLs don't work for Workers with Durable Objects, hence a copy.
  "env": {
    "staging": {
      "name": "fruit-market-staging",
      "durable_objects": {
        "bindings": [
          { "name": "ROOMS", "class_name": "RoomDO" },
          { "name": "STATS", "class_name": "StatsDO" },
          { "name": "BOARD", "class_name": "BoardDO" },
          { "name": "MATCH", "class_name": "MatchDO" },
          { "name": "ACCOUNT", "class_name": "AccountDO" }
        ]
      },
      "ratelimits": [
        { "name": "RL_ROOMS", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_DAILY", "namespace_id": "2002", "simple": { "limit": 5, "period": 60 } },
        { "name": "RL_EVENTS", "namespace_id": "2003", "simple": { "limit": 30, "period": 60 } },
        { "name": "RL_ACCOUNT", "namespace_id": "2004", "simple": { "limit": 12, "period": 60 } }
      ]
    }
  }
}
