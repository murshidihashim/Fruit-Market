{
  // Cloudflare Worker: the web game (dist/) plus the online room server.
  "name": "fruit-market",
  "main": "server/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDO" },
      { "name": "STATS", "class_name": "StatsDO" },
      { "name": "BOARD", "class_name": "BoardDO" },
      { "name": "MATCH", "class_name": "MatchDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO"] },
    { "tag": "v2", "new_sqlite_classes": ["StatsDO", "BoardDO", "MatchDO"] }
  ],
  // Per-IP limits for write endpoints (requests per 60 s). See server/limits.ts.
  "ratelimits": [
    { "name": "RL_ROOMS", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_DAILY", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_EVENTS", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
