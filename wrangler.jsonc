{
  // Cloudflare Worker: the web game (dist/) plus the online room server.
  "name": "fruit-market",
  "main": "server/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDO" },
      { "name": "STATS", "class_name": "StatsDO" },
      { "name": "BOARD", "class_name": "BoardDO" },
      { "name": "MATCH", "class_name": "MatchDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO"] },
    { "tag": "v2", "new_sqlite_classes": ["StatsDO", "BoardDO", "MatchDO"] }
  ],
  "observability": { "enabled": true }
}
